DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
# Optional: set this for near-instant slash command updates while developing
DISCORD_GUILD_ID=your_test_guild_id
# Optional
DATA_FILE=./data/loadouts.json
# Optional (used for /song and /playlist add-song)
SONG_CATALOG_FILE=./data/import/songs.normalized.json
# Optional (offline community recommendation dataset for /song suggest)
RECOMMENDATION_FILE=./data/recommendations/community.json
# Optional (for automatic Reddit-backed recommendation imports)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=script:maimai-fav-bot.recommendation-importer:v1.0 (by /u/your_reddit_username)
# Optional (custom assets for /playlist graphic)
# Recommended default tomomai-style preset:
GRAPHIC_THEME_DIR=./data/theme/tomomai
