DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
# Optional: set this for near-instant slash command updates while developing
DISCORD_GUILD_ID=your_test_guild_id
# Optional
# DATA_BACKEND=json
DATA_FILE=./data/loadouts.json
# SQLITE_FILE=./data/loadouts.sqlite
# Optional usage/event logs for expensive commands
# USAGE_LOG_DIR=./logs
# Optional (used for /song and /playlist add-song)
SONG_CATALOG_FILE=./data/import/songs.normalized.json
# Running bot checks this atomically refreshed file on this interval.
CATALOG_RELOAD_INTERVAL_MINUTES=5
# Optional song aliases for /song and /playlist add-song
SONG_ALIAS_FILE=./data/reference/song-aliases.json
CHART_TAGS_FILE=./data/reference/chart-tags.json
PATTERN_LABELS_FILE=./data/reference/pattern-labels.json
MODEL_MIN_NEARBY_BESTS=20
MODEL_MIN_TOTAL_BESTS=50
MODEL_NEARBY_WINDOW=1.0
CHART_TAGS_REPORT_FILE=./data/reference/chart-tags-report.json
# Optional: the daily catalog refresh asks Qwen (DASHSCOPE_API_KEY below) for romaji/English
# aliases of new songs that have none. Each song is asked once.
# SONG_GENERATED_ALIAS_FILE=./data/reference/song-aliases.generated.json
# ALIAS_GENERATOR_MAX_QWEN_CALLS=3
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-plus
# Optional (web-based account link scaffold)
# External account-link service entry URL, for example:
# https://link.example.com/maimai/start
# ACCOUNT_LINK_BASE_URL=
# Optional client id when using a shared multi-bot linker
# ACCOUNT_LINK_CLIENT_ID=maideck
# Public callback URL that the external service should POST account snapshots to:
# https://bot.example.com/account-link/callback
# ACCOUNT_LINK_CALLBACK_PUBLIC_URL=
# Local bind/port for the callback listener inside this bot process
# ACCOUNT_LINK_CALLBACK_BIND=127.0.0.1
# ACCOUNT_LINK_CALLBACK_PORT=8787
# Shared secret expected in the x-account-link-secret header
# ACCOUNT_LINK_SHARED_SECRET=
# Optional signing secret for the public /account link URL
# If omitted, ACCOUNT_LINK_SHARED_SECRET is reused
# ACCOUNT_LINK_SIGNING_SECRET=
# Optional encryption secret for saved linked account sync auth
# If omitted, ACCOUNT_LINK_SHARED_SECRET is reused
# ACCOUNT_LINK_DATA_SECRET=
# Opt-in background recent-play collector. Requires DATA_BACKEND=sqlite and an
# explicit ACCOUNT_LINK_DATA_SECRET different from the signing/shared secret.
# QUIET_READS_ENABLED=false
# Minimum is always clamped to 20 hours.
# QUIET_READ_MIN_INTERVAL_H=20
# Per timer run; maximum is 2.
# QUIET_READ_MAX_ACCOUNTS=2
# Optional account-link session TTL in minutes
# ACCOUNT_LINK_TTL_MINUTES=15
# Public linker base for `/account public`, for example https://link.example.com/p
# ACCOUNT_PUBLIC_BASE_URL=
# Optional maimai DX NET detail-page fetch tuning for account sync
# MAIMAI_SYNC_DETAIL_CONCURRENCY=4
# MAIMAI_SYNC_DETAIL_DELAY_MS=40
# MAIMAI_SYNC_DETAIL_RETRY_DELAY_MS=150
# Optional (custom assets for /playlist graphic)
# Recommended default tomomai-style preset:
GRAPHIC_THEME_DIR=./data/theme/tomomai
