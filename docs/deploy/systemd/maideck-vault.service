[Unit]
Description=TPM-unlocked encrypted storage for MaiDeck personal data
After=local-fs.target
Before=maimaifavbot.service maimaifavbot-linker.service

[Service]
Type=simple
User=crimson
Group=crimson
LoadCredentialEncrypted=maideck-vault-password:/home/crimson/.maideck-vault-password.cred
ExecStartPre=/usr/bin/test -f /home/crimson/.maideck-vault.cipher/gocryptfs.conf
ExecStartPre=/usr/bin/test -d /home/crimson/.maideck-vault.plain
ExecStart=/home/crimson/.local/bin/gocryptfs -fg -nosyslog -passfile %d/maideck-vault-password /home/crimson/.maideck-vault.cipher /home/crimson/.maideck-vault.plain
ExecStop=/usr/bin/fusermount3 -u /home/crimson/.maideck-vault.plain
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
