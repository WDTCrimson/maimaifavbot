[Unit]
Description=maimai Favorite Loadout Discord Bot
Requires=maideck-vault.service
After=network-online.target maideck-vault.service
Wants=network-online.target

[Service]
Type=simple
User=crimson
Group=crimson
WorkingDirectory=/home/crimson/maimaifavbot
Environment=NODE_ENV=production
Environment=PATH=/home/crimson/.nvm/versions/node/v24.10.0/bin:/usr/bin:/bin
EnvironmentFile=/home/crimson/maimaifavbot/.env
ExecStart=/home/crimson/.nvm/versions/node/v24.10.0/bin/node /home/crimson/maimaifavbot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
