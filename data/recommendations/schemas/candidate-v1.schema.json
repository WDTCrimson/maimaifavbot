{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maideck.local/schemas/recommendation-candidate-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "source", "sourceId", "threadId", "url", "titleHint", "chartType", "difficulty", "stance", "rationale", "tags", "confidence", "promptVersion", "model", "contentHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "supersedes": { "type": ["string", "null"] },
    "source": { "const": "reddit" },
    "sourceId": { "type": "string", "minLength": 1 },
    "threadId": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "titleHint": { "type": "string", "minLength": 1 },
    "artistHint": { "type": ["string", "null"] },
    "chartType": { "enum": ["std", "dx", null] },
    "difficulty": { "enum": ["basic", "advanced", "expert", "master", "remaster", null] },
    "stance": { "enum": ["positive", "negative", "mixed", "unclear"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 180 },
    "tags": { "type": "array", "uniqueItems": true, "items": { "enum": ["entry", "tech", "stamina", "accuracy", "speed"] } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "promptVersion": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
