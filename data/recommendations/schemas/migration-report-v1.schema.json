{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maideck.local/schemas/recommendation-migration-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "migrated", "needsChartMapping", "unresolved"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "migrated": { "type": "integer", "minimum": 0 },
    "needsChartMapping": { "type": "array", "items": { "type": "object" } },
    "unresolved": { "type": "array", "items": { "type": "object" } }
  }
}
